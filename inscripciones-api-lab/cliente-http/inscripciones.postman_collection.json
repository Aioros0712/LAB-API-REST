{
  "info": {
    "name": "API de Inscripciones - Taller",
    "description": "Secuencia de 9 peticiones del Paso 6. Reinicia la API (datos en memoria) antes de ejecutar la colección completa con el Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "inscripcion_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. POST inscribir e1 en IS2 (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.test('estado ACTIVA', () => pm.expect(b.estado).to.eql('ACTIVA'));",
              "pm.collectionVariables.set('inscripcion_id', b.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"estudiante_id\": \"e1\",\n  \"curso_codigo\": \"IS2\"\n}" },
        "url": { "raw": "{{base_url}}/inscripciones", "host": ["{{base_url}}"], "path": ["inscripciones"] }
      }
    },
    {
      "name": "2. POST inscribir e1 en IS2 otra vez (409 DUPLICADA)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('detail DUPLICADA', () => pm.expect(pm.response.json().detail).to.eql('DUPLICADA'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"estudiante_id\": \"e1\",\n  \"curso_codigo\": \"IS2\"\n}" },
        "url": { "raw": "{{base_url}}/inscripciones", "host": ["{{base_url}}"], "path": ["inscripciones"] }
      }
    },
    {
      "name": "3. POST inscribir e4 en IS2 (409 PRERREQUISITOS_PENDIENTES)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('detail PRERREQUISITOS_PENDIENTES', () => pm.expect(pm.response.json().detail).to.eql('PRERREQUISITOS_PENDIENTES'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"estudiante_id\": \"e4\",\n  \"curso_codigo\": \"IS2\"\n}" },
        "url": { "raw": "{{base_url}}/inscripciones", "host": ["{{base_url}}"], "path": ["inscripciones"] }
      }
    },
    {
      "name": "4. POST inscribir e2 en IS2 (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('estado ACTIVA', () => pm.expect(pm.response.json().estado).to.eql('ACTIVA'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"estudiante_id\": \"e2\",\n  \"curso_codigo\": \"IS2\"\n}" },
        "url": { "raw": "{{base_url}}/inscripciones", "host": ["{{base_url}}"], "path": ["inscripciones"] }
      }
    },
    {
      "name": "5. POST inscribir e3 en IS2 (409 SIN_CUPO)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('detail SIN_CUPO', () => pm.expect(pm.response.json().detail).to.eql('SIN_CUPO'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"estudiante_id\": \"e3\",\n  \"curso_codigo\": \"IS2\"\n}" },
        "url": { "raw": "{{base_url}}/inscripciones", "host": ["{{base_url}}"], "path": ["inscripciones"] }
      }
    },
    {
      "name": "6. GET inscripcion por id (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('es la inscripcion creada', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('inscripcion_id'))));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/inscripciones/{{inscripcion_id}}", "host": ["{{base_url}}"], "path": ["inscripciones", "{{inscripcion_id}}"] }
      }
    },
    {
      "name": "7. GET inscripciones de e1 (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('e1 tiene al menos una inscripcion', () => pm.expect(pm.response.json().length).to.be.above(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/estudiantes/e1/inscripciones", "host": ["{{base_url}}"], "path": ["estudiantes", "e1", "inscripciones"] }
      }
    },
    {
      "name": "8. PATCH cancelar inscripcion (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('estado CANCELADA', () => pm.expect(pm.response.json().estado).to.eql('CANCELADA'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"estado\": \"CANCELADA\"\n}" },
        "url": { "raw": "{{base_url}}/inscripciones/{{inscripcion_id}}", "host": ["{{base_url}}"], "path": ["inscripciones", "{{inscripcion_id}}"] }
      }
    },
    {
      "name": "9. GET cursos (200, IS2 con 1 cupo disponible)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const is2 = pm.response.json().find(c => c.codigo === 'IS2');",
              "pm.test('IS2 tiene 1 cupo disponible', () => pm.expect(is2.cupos_disponibles).to.eql(1));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/cursos", "host": ["{{base_url}}"], "path": ["cursos"] }
      }
    }
  ]
}
